{
  "name": "closer-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node ../../packages/closer/scripts/syncBuildLocales.cjs && node ../../packages/closer/scripts/syncBuildConfig.cjs",
    "dev": "pnpm prebuild && dotenv -e .env.local -e .env next dev --turbo",
    "build": "next build",
    "postbuild": "node ../../packages/closer/scripts/deleteClientSourceMaps.cjs",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@mdx-js/loader": "catalog:",
    "@mdx-js/react": "catalog:",
    "@next/mdx": "catalog:",
    "@sentry/nextjs": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tailwindcss/forms": "catalog:",
    "@tailwindcss/line-clamp": "catalog:",
    "@types/leaflet": "catalog:",
    "closer": "workspace:*",
    "gray-matter": "catalog:",
    "leaflet": "catalog:",
    "next": "catalog:",
    "nextjs-google-analytics": "^2.3.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-ga": "^3.3.1",
    "ui": "*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@types/node": "^17.0.12",
    "@types/react": "^18.0.22",
    "@types/react-dom": "catalog:",
    "autoprefixer": "catalog:",
    "config": "*",
    "eslint-config-custom": "workspace:*",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsconfig": "workspace:*",
    "typescript": "^5.0.0"
  },
  "msw": {
    "workerDirectory": "public"
  }
