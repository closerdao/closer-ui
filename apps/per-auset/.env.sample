NEXT_PUBLIC_CDN_URL=https://cdn.oasa.co/photo/
# NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=https://dev.api.project.com

# Cloudflare Turnstile site key (not a secret, but leave blank unless you know
# you need it). Must be the site key paired with the CLOUDFLARE_SECRET_KEY of
# whichever API NEXT_PUBLIC_API_URL points at, and "localhost" must be listed
# in that Turnstile widget's allowed hostnames in the Cloudflare dashboard.
# If left blank while NEXT_PUBLIC_API_URL points at a remote API that
# enforces Turnstile, login/signup will fail with "Turnstile verification
# failed" once the local dev session's isHuman flag lapses. Running the API
# locally with ENVIRONMENT=local (or SKIP_TURNSTILE=true) skips verification
# entirely, so you can leave this blank.
NEXT_PUBLIC_CLOUDFLARE_KEY=
NEXT_PUBLIC_PLATFORM=
NEXT_PUBLIC_LOG_REQUESTS=false

NEXT_PUBLIC_TOKEN_SALE_DATE="2023-05-12T00:00:00.000Z"
NEXT_PUBLIC_NETWORK=celoSepolia
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=