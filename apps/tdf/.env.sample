# ENVIRONMENT=local

# API and CDN Configuration
NEXT_PUBLIC_CDN_URL=https://cdn.example.com/photo/
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudflare Turnstile site key (not a secret, but leave blank unless you know
# you need it). Must be the site key paired with the CLOUDFLARE_SECRET_KEY of
# whichever API NEXT_PUBLIC_API_URL points at, and "localhost" must be listed
# in that Turnstile widget's allowed hostnames in the Cloudflare dashboard.
# If left blank while NEXT_PUBLIC_API_URL points at a remote API that
# enforces Turnstile, login/signup will fail with "Turnstile verification
# failed" once the local dev session's isHuman flag lapses. Running the API
# locally with ENVIRONMENT=local (or SKIP_TURNSTILE=true) skips verification
# entirely, so you can leave this blank.
NEXT_PUBLIC_CLOUDFLARE_KEY=
NEXT_PUBLIC_PLATFORM=your_platform
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_LOG_REQUESTS=false
NEXT_PUBLIC_IS_FEDERATION=true

# Stripe Configuration
NEXT_PUBLIC_PLATFORM_STRIPE_PUB_KEY=pk_test_your_platform_stripe_public_key
NEXT_PUBLIC_STRIPE_CONNECTED_ACCOUNT=acct_your_connected_account
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PLATFORM_STRIPE_SECRET_KEY=sk_test_your_platform_stripe_secret_key
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/test_your_portal_id

# Feature Flags
NEXT_PUBLIC_FEATURE_WEB3_BOOKING=true
NEXT_PUBLIC_FEATURE_WEB3_WALLET=true
NEXT_PUBLIC_FEATURE_BOOKING=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=true
NEXT_PUBLIC_FEATURE_CARROTS=true
NEXT_PUBLIC_FEATURE_TOKEN_SALE=true
NEXT_PUBLIC_FEATURE_COURSES=true
NEXT_PUBLIC_FEATURE_SUPPORT_US=true
NEXT_PUBLIC_FEATURE_BLOG=true
NEXT_PUBLIC_FEATURE_REFERRAL=true
NEXT_PUBLIC_FEATURE_STABLECOIN_BOOKING=false
NEXT_PUBLIC_FEATURE_VOLUNTEERING=true
NEXT_PUBLIC_FEATURE_AFFILIATE=true
NEXT_PUBLIC_FEATURE_CITIZENSHIP=true
NEXT_PUBLIC_FEATURE_LOCALE_SWITCH=true

# The seasonal team & residency tool at /roles/[id]. Sets the starting value of
# the `residency` config doc's `enabled` flag; once an admin saves that setting
# the config doc wins. The /roles pages themselves are gated separately by the
# `roles` config doc.
NEXT_PUBLIC_FEATURE_RESIDENCY=true

# Web3 Configuration
NEXT_PUBLIC_NETWORK=celoSepolia
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_TOKEN_SALE_DATE=01/04/2023

# Google Services
NEXT_PUBLIC_GOOGLE_TAG_MANAGER=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_CONFIG='{
  "apiKey": "your_api_key",
  "authDomain": "your_project.firebaseapp.com",
  "projectId": "your_project_id",
  "storageBucket": "your_project.appspot.com",
  "messagingSenderId": "your_sender_id",
  "appId": "your_app_id"
}'

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Business Configuration
NEXT_PUBLIC_VAT_RATE=0.23
NEXT_PUBLIC_APP_NAME=your_app_name

# Test Accounts (Development Only)
TEST_ADMIN_EMAIL=admin@example.com
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=your_test_password


ENVIRONMENT=local