{
  "name": "closer-ui",
  "version": "0.1.1",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/closer",
    "apps/earthbound",
    "apps/village-app",
    "apps/lios",
    "apps/tdf",
    "packages/*"
  ],
  "scripts": {
    "prepare": "node packages/closer/scripts/ensureBuildConfigSnapshotExists.cjs && node packages/closer/scripts/syncBuildLocales.cjs && husky",
    "build": "turbo run build:locales build:config --filter=closer && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint-fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "cypress:open": "cypress open",
    "locale:prune": "node packages/closer/scripts/pruneUnusedLocaleKeys.cjs",
    "locale:prune:write": "node packages/closer/scripts/pruneUnusedLocaleKeys.cjs --write",
    "build:locales": "node packages/closer/scripts/syncBuildLocales.cjs",
    "dev:locales": "node packages/closer/scripts/watchLocales.cjs",
    "build:config": "node packages/closer/scripts/syncBuildConfig.cjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/sanitize-html": "^2.16.0",
    "chokidar": "^4.0.3",
    "dotenv-cli": "^7.0.0",
    "eslint-config-custom": "*",
    "husky": "^9",
    "lint-staged": "^16",
    "msw": "^1.2.1",
    "next-router-mock": "^0.9.3",
    "prettier": "^3.9.6",
    "turbo": "^2.9.14"
  },
  "resolutions": {
    "axios/form-data": "^4.0.5",
    "elliptic": "^6.6.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.21.0",
    "@xmldom/xmldom": "^0.8.15",
    "undici": "^7.29.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@google/genai": "^1.12.0",
    "axios": "^1.18.0",
    "deepmerge": "^4.3.1",
    "jimp": "^1.6.0",
    "next": "15.5.25",
    "next-intl": "^4.9.2",
    "nextjs-google-analytics": "^2.3.7",
    "posthog-js": "^1.418.10"
  }
}
