{
  "name": "closer-ui",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "prepare": "node packages/closer/scripts/ensureBuildConfigSnapshotExists.cjs && node packages/closer/scripts/syncBuildLocales.cjs && husky",
    "build": "turbo run build:locales build:config --filter=closer && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint-fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "cypress:open": "cypress open",
    "locale:prune": "node packages/closer/scripts/pruneUnusedLocaleKeys.cjs",
    "locale:prune:write": "node packages/closer/scripts/pruneUnusedLocaleKeys.cjs --write",
    "build:locales": "node packages/closer/scripts/syncBuildLocales.cjs",
    "dev:locales": "node packages/closer/scripts/watchLocales.cjs",
    "build:config": "node packages/closer/scripts/syncBuildConfig.cjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@posthog/nextjs-config": "^1.11.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/sanitize-html": "^2.16.0",
    "chokidar": "^4.0.3",
    "cypress": "^13.12.0",
    "dotenv-cli": "^7.0.0",
    "eslint-config-custom": "workspace:*",
    "husky": "^9",
    "lint-staged": "^16",
    "prettier": "^3.9.6",
    "turbo": "^2.11.2",
    "@types/node": "catalog:"
  }
}
